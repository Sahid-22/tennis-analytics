# Copy this file to .env and fill in your own key.
SPORTRADAR_API_KEY=your_sportradar_api_key_here

# The app works with any SQLAlchemy URL. SQLite is the default for local review.
# Examples:
# DATABASE_URL=sqlite:///data/tennis_analytics.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tennis_analytics
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/tennis_analytics

SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_LANGUAGE=en
SPORTRADAR_TIMEOUT_SECONDS=30
SPORTRADAR_MAX_RETRIES=3

